<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Task Name -->
        <TextView
            android:id="@+id/textViewDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="100-hour inspection"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Tail Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tail Number"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textViewDetailTailNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="N12345"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Task Type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Task Type"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textViewDetailTaskType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Inspection"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textViewDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Open"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Due Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due Date"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textViewDetailDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="12/15/2026"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Due Time -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due Time"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textViewDetailTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="01:30 PM"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Notes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textViewDetailNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Check oil filter and chip detector"
            android:textSize="16sp"
            android:layout_marginBottom="32dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="24dp" />

        <!-- Edit Button -->
        <Button
            android:id="@+id/buttonEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Task"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <!-- Share Button -->
        <Button
            android:id="@+id/buttonShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share Task"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp"
            style="?attr/materialButtonOutlinedStyle" />

        <!-- Delete Button -->
        <Button
            android:id="@+id/buttonDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Task"
            android:minHeight="48dp"
            android:backgroundTint="#D32F2F" />

    </LinearLayout>

</ScrollView>