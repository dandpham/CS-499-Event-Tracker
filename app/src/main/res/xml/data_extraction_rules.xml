<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12 and higher. Turning off allowBackup doesn't stop
   device-to-device transfers on these versions, so the database and login
   session are excluded from both cloud backups and transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
