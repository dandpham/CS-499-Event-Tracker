<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower. Backups are also turned off in the
   manifest. The database holds password hashes and maintenance records, and
   the shared preferences hold the login session, so neither is backed up.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
